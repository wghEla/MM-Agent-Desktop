{
  "productName": "MM-Agent Desktop",
  "version": "1.0.0-rebuild.1",
  "identifier": "com.mmagent.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MM-Agent Desktop",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/mmagent-sidecar"
    ],
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
